# Production example for buitrago.geomaticaupv.es.
# Copy this file to .env.prod on the VPS and replace CHANGE_ME values there.

POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=buitrago
POSTGRES_HOST=postgis
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=CHANGE_ME_GENERATED_WITH_DJANGO
SECRET_KEY=CHANGE_ME_GENERATED_WITH_DJANGO
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME
DJANGO_SUPERUSER_EMAIL=CHANGE_ME
DJANGO_ALLOWED_HOSTS=buitrago.geomaticaupv.es
DEBUG=False
CORS_ALLOWED_ORIGINS=https://buitrago.geomaticaupv.es
DJANGO_CSRF_TRUSTED_ORIGINS=https://buitrago.geomaticaupv.es
EPSG_FOR_GEOMETRIES=9377
ST_SNAP_PRECISION=0.0001
MAX_NUMBER_OF_RETRIEVED_ROWS=10000
FORCE_SCRIPT_NAME=/api
API_URL=https://buitrago.geomaticaupv.es/api/
WEB_URL=https://buitrago.geomaticaupv.es
TEMPLATE_ASSETS_URL=https://buitrago.geomaticaupv.es/static/
STATIC_ROOT=static_root
STATIC_URL=https://buitrago.geomaticaupv.es/static_root/

DJANGO_SESSION_EXPIRY_DAYS=100
TOKEN_LIMIT_PER_USER=3
DJANGO_KNOX_AUTOMATICALLY_REMOVE_TOKENS=1

EMAIL_HOST=smtp.upv.es
EMAIL_USE_TLS=True
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME
EMAIL_UPV=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_FROM=CHANGE_ME
DJANGO_EMAIL_FOR_ERRORS_USER_NAME=Buitrago
DJANGO_EMAIL_FOR_ERRORS_EMAIL=CHANGE_ME
